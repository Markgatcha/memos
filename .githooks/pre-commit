#!/bin/sh
# Pre-commit hook (memos): auto-format staged .ts with prettier and
# auto-fix with eslint, then re-stage. Non-blocking — it cleans up the
# commit but never fails it (CI is the gate for real errors).
#
# Activate once with: git config core.hooksPath .githooks
set -e

# Only run inside the memos repo working tree.
if [ ! -f package.json ]; then
  exit 0
fi

# Collect staged .ts files (tracked + newly added).
staged=$(git diff --cached --diff-filter=ACMR --name-only -- '*.ts' || true)
if [ -z "$staged" ]; then
  exit 0
fi

# Auto-format with prettier (idempotent), then auto-fix with eslint.
# Both run only on the staged files to keep the hook fast.
npx prettier --write $staged >/dev/null 2>&1 || true
npx eslint --fix $staged >/dev/null 2>&1 || true

# Re-stage anything the formatters touched.
echo "$staged" | while IFS= read -r f; do
  if [ -n "$f" ]; then
    git add -- "$f"
  fi
done

exit 0
