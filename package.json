{
  "name": "@mem-os/sdk",
  "version": "1.6.27",
  "description": "Universal, local-first, persistent memory layer for AI agents, LLM apps, and chatbots.",
  "license": "MIT",
  "author": "Markgatcha",
  "homepage": "https://github.com/Markgatcha/memos",
  "repository": {
    "type": "git",
    "url": "https://github.com/Markgatcha/memos.git"
  },
  "bugs": {
    "url": "https://github.com/Markgatcha/memos/issues"
  },
  "keywords": [
    "memory",
    "ai-memory",
    "llm",
    "agent",
    "agent-memory",
    "graph",
    "sqlite",
    "local-first",
    "ollama",
    "langchain",
    "chatbot",
    "persistent-memory",
    "context-window",
    "rag",
    "vector-memory",
    "embedding",
    "mcp",
    "mem0",
    "local-llm",
    "semantic-search",
    "model2vec",
    "ann",
    "longmemeval",
    "crash-reporting"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp.js",
      "types": "./dist/mcp.d.ts"
    },
    "./sqlite": {
      "import": "./dist/storage/sqlite.js",
      "types": "./dist/storage/sqlite.d.ts"
    },
    "./openai": {
      "import": "./dist/adapters/openai.js",
      "types": "./dist/adapters/openai.d.ts"
    },
    "./anthropic": {
      "import": "./dist/adapters/anthropic.js",
      "types": "./dist/adapters/anthropic.d.ts"
    },
    "./vercel": {
      "import": "./dist/adapters/vercel.js",
      "types": "./dist/adapters/vercel.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "UPGRADING.md"
  ],
  "bin": {
    "memos": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "oxlint src --quiet",
    "lint:fix": "oxlint src --fix",
    "format": "bun fmt src",
    "format:check": "bun fmt --check src",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "pnpm run clean && pnpm run build && pnpm run check:pack && pnpm run check:versions",
    "serve": "node dist/cli.js serve",
    "bench": "tsx scripts/bench.ts",
    "bench:quality": "tsx scripts/bench-quality.ts",
    "bench:quality:local": "tsx scripts/bench-quality.ts --provider=local",
    "bench:toon": "tsx scripts/bench-toon-formats.ts",
    "bench:beam": "tsx scripts/bench-beam.ts",
    "bench:beam:100k": "tsx scripts/bench-beam.ts --scale=100k",
    "bench:beam:1m": "tsx scripts/bench-beam.ts --scale=1m",
    "bench:locomo:retrieve": "tsx scripts/bench-locomo-noapi.ts",
    "bench:vendors": "tsx scripts/bench-vendors.ts",
    "bench:locomo": "OPENAI_API_KEY=$OPENAI_API_KEY tsx scripts/bench-locomo.ts",
    "bench:longmemeval": "OPENAI_API_KEY=$OPENAI_API_KEY tsx scripts/bench-longmemeval.ts",
    "bench:crossrepo": "tsx scripts/bench-crossrepo.ts",
    "bench:memory": "tsx scripts/bench-memory.ts",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "bench:longmemeval:retrieve": "tsx scripts/bench-longmemeval.ts --retrieve-only",
    "check:plugin": "node scripts/check-plugin-version.mjs && node scripts/check-plugin-manifests.mjs",
    "check:plugin-manifests": "node scripts/check-plugin-manifests.mjs",
    "check:pack": "node scripts/check-pack-size.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "eval:retrieval": "tsx scripts/eval-retrieval.ts",
    "redteam:quarantine": "tsx scripts/redteam-quarantine.ts",
    "eval:retrieval:check": "tsx scripts/eval-retrieval.ts --check",
    "eval:retrieval:baseline": "tsx scripts/eval-retrieval.ts --write-baseline",
    "bench:convomem": "tsx scripts/bench-convomem.ts",
    "download:convomem": "tsx scripts/download-convomem.ts",
    "docs:llms": "node scripts/gen-llms-txt.mjs",
    "docs:llms:check": "node scripts/gen-llms-txt.mjs --check",
    "docs:coverage": "node scripts/docs-coverage.mjs",
    "docs:reference": "tsx scripts/gen-docs-reference.ts",
    "plugin:sync": "node scripts/sync-agent-plugin.mjs",
    "plugin:check": "node scripts/sync-agent-plugin.mjs --check",
    "check:server-json": "node scripts/check-server-json.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "better-sqlite3": "^13.0.3",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@xenova/transformers": "^2.17.2"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    },
    "@xenova/transformers": {
      "optional": true
    }
  },
  "overrides": {
    "brace-expansion@>=4.0.0 <5.0.5": "5.0.5",
    "js-yaml": ">=4.1.0",
    "adm-zip": "^0.6.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "jest": "^30.5.2",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "@swc/core": true,
    "esbuild": true,
    "unrs-resolver": true,
    "better-sqlite3-multiple-ciphers": true,
    "protobufjs@7.6.6": true,
    "@parcel/watcher@2.6.0": true,
    "onnxruntime-node@1.30.0": true
  },
  "optionalDependencies": {
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "sqlite-vec": "0.1.9"
  },
  "packageManager": "pnpm@12.14.0"
}
